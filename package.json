{
  "name": "1day-1ott",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:api": "pnpm --filter @1ott/api dev",
    "dev:web": "pnpm --filter @1ott/web dev",
    "db:generate": "pnpm --filter @1ott/api db:generate",
    "db:migrate:local": "pnpm --filter @1ott/api db:migrate:local",
    "deploy": "pnpm --filter @1ott/web build && pnpm --filter @1ott/api run deploy",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"],
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0"
    }
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "1day-1ott",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-31",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // 웹 빌드 결과물을 같은 Worker 에서 서빙 (same-origin → CORS/쿠키 문제 없음).
  // /api/*, /health, 기존 프로필 URL만 Worker가 먼저 받고, 나머지는 정적 자산 + SPA 폴백.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/u/*",
      "/@*",
      "/.well-known/*",
      "/ap/*"
    ]
  },
  // 프로덕션 공개 값. 시크릿(BETTER_AUTH_SECRET, RESEND_API_KEY, TMDB_API_TOKEN)은 `wrangler secret put` 으로.
  "vars": {
    "BETTER_AUTH_URL": "https://1day1ott.com",
    "WEB_ORIGIN": "https://1day1ott.com",
    "MEDIA_ORIGIN": "https://media.1day1ott.com"
  },
  "routes": [
    {
      "pattern": "1day1ott.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "1ott-db",
      // 로컬(miniflare)은 이 id를 무시함.
      "database_id": "06a84b42-939e-4a0b-81b4-14a70f3a0d1c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "1ott-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FEDIFY_ORDERING_KV",
      "id": "640fb51d4c47462f8bbf758f83aab9d0"
    }
  ],
  "ratelimits": [
    {
      "name": "FEDERATION_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "FEDIFY_QUEUE",
        "queue": "1ott-fedify"
      }
    ],
    "consumers": [
      {
        "queue": "1ott-fedify",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "1ott-fedify-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
